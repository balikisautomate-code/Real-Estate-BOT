# Application
APP_ENV=development
APP_NAME=Real Estate Lead Bot
APP_VERSION=0.1.0
DEBUG=true

# Database (MySQL — local development)
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/real_estate_leads

# Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=change-me-n8n-secret

# AI Provider (example)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# Google Sheets (optional operational reporting)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Logging
LOG_LEVEL=INFO
